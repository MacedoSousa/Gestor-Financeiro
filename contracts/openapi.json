      "get": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Pedidos de celular novo do outro cônjuge, pendentes e no prazo, com o código para conferir.",
        "operationId": "ListarPedidosDoConjuge",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PedidoPendenteDto"
                  }
                }
              }
            }
          }
        }
      }
    },
