          "Autenticacao"
        ],
        "summary": "CPF + código de recuperação: gira o código (o novo vem uma única vez, no-store) e emite o cookie de autorização de registro.",
        "operationId": "RecuperarAcesso",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecuperacaoDto"
              }
            }
