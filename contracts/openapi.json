      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Pedido aprovado e no prazo vira o cookie de autorização de registro (uso único); senão 409.",
        "operationId": "ResgatarPedidoDeDispositivo",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
