  "paths": {
    "/api/v1/saude": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Verificação simples de que a API está de pé.",
        "operationId": "Saude",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaudeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal/codigo-recuperacao": {
      "post": {
        "tags": [
          "Identidade"
        ],
        "summary": "Gera um código de recuperação novo para o casal (o anterior deixa de valer); mostrado uma única vez, no-store. Exige confirmação recente.",
        "operationId": "GerarCodigoDeRecuperacao",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodigoRecuperacaoDto"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal": {
      "get": {
        "tags": [
          "Identidade"
        ],
        "summary": "Membros do casal do usuário logado (sem CPF).",
        "operationId": "ObterCasal",
