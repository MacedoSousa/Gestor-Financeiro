    "/api/v1/auth/dispositivo/pedido": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Pede a entrada de um celular novo; devolve o código de 6 dígitos (no-store) e o cookie do pedido, exista o CPF ou não.",
        "operationId": "PedirDispositivo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoPedidoDeDispositivoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoCriadoDto"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Só o estado do pedido (PENDENTE, APROVADO ou EXPIRADO), sem efeito colateral. Sem cookie válido: PENDENTE.",
        "operationId": "ConsultarPedidoDeDispositivo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoDoPedidoDto"
                }
              }
            }
          }
        }
      }
    },
