{
  "openapi": "3.1.1",
  "info": {
    "title": "GestorFinanceiro.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/saude": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Verificação simples de que a API está de pé.",
        "operationId": "Saude",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaudeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal": {
      "get": {
        "tags": [
          "Identidade"
        ],
        "summary": "Membros do casal do usuário logado (sem CPF).",
        "operationId": "ObterCasal",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasalDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "post": {
        "tags": [
          "Identidade"
        ],
        "summary": "Cadastra o casal, os dois cônjuges e os envelopes da DEK. Devolve o código de recuperação uma única vez.",
        "operationId": "CadastrarCasal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroDoCasalDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasalCadastradoDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal/cadastro": {
      "get": {
        "tags": [
          "Identidade"
        ],
        "summary": "Informa se o cadastro do casal ainda está aberto nesta instalação.",
        "operationId": "ObterEstadoDoCadastro",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoDoCadastroDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/eu": {
      "get": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Quem está logado e se a confirmação de identidade ainda é recente.",
        "operationId": "ObterEu",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EuDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sair": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Encerra a sessão (se houver) e apaga o cookie; sempre 204.",
        "operationId": "Sair",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CadastroDoCasalDto": {
        "required": [
          "codigoInstalacao",
          "nomeFamilia",
          "conjuge1",
          "conjuge2"
        ],
        "type": "object",
        "properties": {
          "codigoInstalacao": {
            "type": "string"
          },
          "nomeFamilia": {
            "type": "string"
          },
          "conjuge1": {
            "$ref": "#/components/schemas/ConjugeNovoDto"
          },
          "conjuge2": {
            "$ref": "#/components/schemas/ConjugeNovoDto"
          }
        }
      },
      "CasalCadastradoDto": {
        "required": [
          "casalId",
          "codigoRecuperacao"
        ],
        "type": "object",
        "properties": {
          "casalId": {
            "type": "string",
            "format": "uuid"
          },
          "codigoRecuperacao": {
            "type": "string"
          }
        }
      },
      "CasalDto": {
        "required": [
          "id",
          "membros"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "membros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembroDto"
            }
          }
        }
      },
      "ConjugeNovoDto": {
        "required": [
          "nomeCompleto",
          "cpf",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nomeCompleto": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "EstadoDoCadastroDto": {
        "required": [
          "disponivel"
        ],
        "type": "object",
        "properties": {
          "disponivel": {
            "type": "boolean"
          }
        }
      },
      "EuDto": {
        "required": [
          "usuarioId",
          "apelido",
          "apelidoDoConjuge",
          "confirmacaoRecente"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "apelido": {
            "type": "string"
          },
          "apelidoDoConjuge": {
            "type": "string"
          },
          "confirmacaoRecente": {
            "type": "boolean"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MembroDto": {
        "required": [
          "id",
          "apelido",
          "ehVoce"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "apelido": {
            "type": "string"
          },
          "ehVoce": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SaudeDto": {
        "required": [
          "status",
          "horario"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "horario": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Sistema"
    },
    {
      "name": "Identidade"
    },
    {
      "name": "Autenticacao"
    }
  ]
}