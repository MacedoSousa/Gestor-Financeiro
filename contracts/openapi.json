  "components": {
    "schemas": {
      "AssercaoDePasskeyDto": {
        "required": [
          "clientDataJSON",
          "authenticatorData",
          "signature",
          "userHandle"
        ],
        "type": "object",
        "properties": {
          "clientDataJSON": {
            "type": "string"
          },
          "authenticatorData": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "userHandle": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AtestacaoDePasskeyDto": {
        "required": [
          "clientDataJSON",
          "attestationObject",
          "transports"
        ],
        "type": "object",
        "properties": {
          "clientDataJSON": {
            "type": "string"
          },
          "attestationObject": {
            "type": "string"
          },
          "transports": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
