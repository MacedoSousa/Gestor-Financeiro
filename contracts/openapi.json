{
  "openapi": "3.1.1",
  "info": {
    "title": "GestorFinanceiro.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/saude": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Verificação simples de que a API está de pé.",
        "operationId": "Saude",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaudeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal": {
      "get": {
        "tags": [
          "Identidade"
        ],
        "summary": "Membros do casal do usuário logado (sem CPF).",
        "operationId": "ObterCasal",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasalDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "post": {
        "tags": [
          "Identidade"
        ],
        "summary": "Cadastra o casal, os dois cônjuges e os envelopes da DEK. Devolve o código de recuperação uma única vez.",
        "operationId": "CadastrarCasal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroDoCasalDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasalCadastradoDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/casal/cadastro": {
      "get": {
        "tags": [
          "Identidade"
        ],
        "summary": "Informa se o cadastro do casal ainda está aberto nesta instalação.",
        "operationId": "ObterEstadoDoCadastro",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoDoCadastroDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/eu": {
      "get": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Quem está logado e se a confirmação de identidade ainda é recente.",
        "operationId": "ObterEu",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EuDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sair": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Encerra a sessão (se houver) e apaga o cookie; sempre 204.",
        "operationId": "Sair",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/primeiro-acesso": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Primeiro acesso por CPF e senha do cadastro; responde 204 com o cookie de autorização de registro.",
        "operationId": "PrimeiroAcesso",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrimeiroAcessoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/totp/registro": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Gera um segredo TOTP não confirmado e devolve a URI otpauth (no-store). Exige o cookie de autorização de registro.",
        "operationId": "RegistrarTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoTotpDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpGeradoDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/totp/confirmacao": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Confirma o TOTP com o primeiro código, encerra o primeiro acesso e abre a sessão (204 com cookie).",
        "operationId": "ConfirmarTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmarTotpDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/totp": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Entra com CPF e código TOTP; 204 com o cookie de sessão.",
        "operationId": "EntrarComTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntrarComTotpDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkey/registro/opcoes": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Opções de criação da passkey (credencial descobrível, UV obrigatória, attestation none). Exige o cookie de autorização de registro.",
        "operationId": "OpcoesDeRegistroDePasskey",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpcoesDeRegistroDePasskeyDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkey/registro": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Grava a passkey, encerra o primeiro acesso e abre a sessão (204 com cookie).",
        "operationId": "RegistrarPasskey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovaPasskeyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkey/opcoes": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Opções de asserção sem allowCredentials (credencial descobrível) e com UV obrigatória.",
        "operationId": "OpcoesDeLoginComPasskey",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpcoesDeLoginComPasskeyDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkey": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Entra com a asserção da passkey; 204 com o cookie de sessão.",
        "operationId": "EntrarComPasskey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespostaDeLoginComPasskeyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssercaoDePasskeyDto": {
        "required": [
          "clientDataJSON",
          "authenticatorData",
          "signature",
          "userHandle"
        ],
        "type": "object",
        "properties": {
          "clientDataJSON": {
            "type": "string"
          },
          "authenticatorData": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "userHandle": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AtestacaoDePasskeyDto": {
        "required": [
          "clientDataJSON",
          "attestationObject",
          "transports"
        ],
        "type": "object",
        "properties": {
          "clientDataJSON": {
            "type": "string"
          },
          "attestationObject": {
            "type": "string"
          },
          "transports": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CadastroDoCasalDto": {
        "required": [
          "codigoInstalacao",
          "nomeFamilia",
          "conjuge1",
          "conjuge2"
        ],
        "type": "object",
        "properties": {
          "codigoInstalacao": {
            "type": "string"
          },
          "nomeFamilia": {
            "type": "string"
          },
          "conjuge1": {
            "$ref": "#/components/schemas/ConjugeNovoDto"
          },
          "conjuge2": {
            "$ref": "#/components/schemas/ConjugeNovoDto"
          }
        }
      },
      "CasalCadastradoDto": {
        "required": [
          "casalId",
          "codigoRecuperacao"
        ],
        "type": "object",
        "properties": {
          "casalId": {
            "type": "string",
            "format": "uuid"
          },
          "codigoRecuperacao": {
            "type": "string"
          }
        }
      },
      "CasalDto": {
        "required": [
          "id",
          "membros"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "membros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembroDto"
            }
          }
        }
      },
      "ConfirmarTotpDto": {
        "required": [
          "credencialId",
          "codigo"
        ],
        "type": "object",
        "properties": {
          "credencialId": {
            "type": "string",
            "format": "uuid"
          },
          "codigo": {
            "type": "string"
          }
        }
      },
      "ConjugeNovoDto": {
        "required": [
          "nomeCompleto",
          "cpf",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nomeCompleto": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "DescritorDeCredencialDto": {
        "required": [
          "id",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "EntrarComTotpDto": {
        "required": [
          "cpf",
          "codigo"
        ],
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          }
        }
      },
      "EstadoDoCadastroDto": {
        "required": [
          "disponivel"
        ],
        "type": "object",
        "properties": {
          "disponivel": {
            "type": "boolean"
          }
        }
      },
      "EuDto": {
        "required": [
          "usuarioId",
          "apelido",
          "apelidoDoConjuge",
          "confirmacaoRecente"
        ],
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "apelido": {
            "type": "string"
          },
          "apelidoDoConjuge": {
            "type": "string"
          },
          "confirmacaoRecente": {
            "type": "boolean"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MembroDto": {
        "required": [
          "id",
          "apelido",
          "ehVoce"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "apelido": {
            "type": "string"
          },
          "ehVoce": {
            "type": "boolean"
          }
        }
      },
      "NovaPasskeyDto": {
        "required": [
          "apelido",
          "resposta"
        ],
        "type": "object",
        "properties": {
          "apelido": {
            "type": "string"
          },
          "resposta": {
            "$ref": "#/components/schemas/RespostaDeRegistroDePasskeyDto"
          }
        }
      },
      "NovoTotpDto": {
        "required": [
          "apelido"
        ],
        "type": "object",
        "properties": {
          "apelido": {
            "type": "string"
          }
        }
      },
      "OpcoesDeLoginComPasskeyDto": {
        "required": [
          "challenge",
          "timeout",
          "rpId",
          "userVerification"
        ],
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string"
          },
          "timeout": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "rpId": {
            "type": "string"
          },
          "userVerification": {
            "type": "string"
          }
        }
      },
      "OpcoesDeRegistroDePasskeyDto": {
        "required": [
          "rp",
          "user",
          "challenge",
          "pubKeyCredParams",
          "timeout",
          "excludeCredentials",
          "authenticatorSelection",
          "attestation"
        ],
        "type": "object",
        "properties": {
          "rp": {
            "$ref": "#/components/schemas/RpDePasskeyDto"
          },
          "user": {
            "$ref": "#/components/schemas/UsuarioDePasskeyDto"
          },
          "challenge": {
            "type": "string"
          },
          "pubKeyCredParams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParametroDeChaveDto"
            }
          },
          "timeout": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "excludeCredentials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DescritorDeCredencialDto"
            }
          },
          "authenticatorSelection": {
            "$ref": "#/components/schemas/SelecaoDeAutenticadorDto"
          },
          "attestation": {
            "type": "string"
          }
        }
      },
      "ParametroDeChaveDto": {
        "required": [
          "type",
          "alg"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "alg": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PrimeiroAcessoDto": {
        "required": [
          "cpf",
          "senha"
        ],
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RespostaDeLoginComPasskeyDto": {
        "required": [
          "id",
          "rawId",
          "type",
          "response"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rawId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "response": {
            "$ref": "#/components/schemas/AssercaoDePasskeyDto"
          }
        }
      },
      "RespostaDeRegistroDePasskeyDto": {
        "required": [
          "id",
          "rawId",
          "type",
          "response"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rawId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "response": {
            "$ref": "#/components/schemas/AtestacaoDePasskeyDto"
          }
        }
      },
      "RpDePasskeyDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "SaudeDto": {
        "required": [
          "status",
          "horario"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "horario": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SelecaoDeAutenticadorDto": {
        "required": [
          "residentKey",
          "requireResidentKey",
          "userVerification"
        ],
        "type": "object",
        "properties": {
          "residentKey": {
            "type": "string"
          },
          "requireResidentKey": {
            "type": "boolean"
          },
          "userVerification": {
            "type": "string"
          }
