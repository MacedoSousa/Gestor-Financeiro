{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(npm run:*)",
      "Bash(npm --prefix frontend run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(scripts/verificar.sh:*)",
      "Bash(scripts/guardas/verificar-repositorio.sh:*)",
      "Bash(scripts/guardas/testes.sh:*)",
      "mcp__playwright__browser_console_messages",
      "Bash(./gradlew lint)",
      "Bash(./gradlew testDebugUnitTest)",
      "Bash(./gradlew assembleDebug)",
      "Bash(./gradlew assembleRelease)",
      "Bash(./gradlew openApiGenerate)",
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew verifyRoborazziDebug)",
      "Bash(./gradlew recordRoborazziDebug)",
      "Bash(./gradlew koverXmlReport)",
      "Bash(./gradlew connectedDebugAndroidTest)",
      "Bash(adb devices)",
      "Bash(adb install -r android/app/build/outputs/:*)",
      "Bash(adb logcat --pid:*)",
      "Bash(sdkmanager --list)",
      "Bash(sdkmanager --list_installed)",
      "Bash(emulator -avd gf-pixel-api36)",
      "Bash(emulator -accel-check)",
      "Bash(emulator -list-avds)",
      "Bash(avdmanager list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./infra/secrets/**)",
      "Read(./backups/**)",
      "Read(./infra/data/**)",
      "Read(//opt/**)",
      "Edit(//opt/**)",
      "Edit(./infra/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(psql:*)",
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.bks)",
      "Read(**/*.pepk)",
      "Read(**/local.properties)",
      "Read(~/.android/**)",
      "Read(~/.gradle/gradle.properties)",
      "Read(**/*service-account*.json)",
      "Bash(./gradlew --scan:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-delete-fisico.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardar-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verificar.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  }
}
