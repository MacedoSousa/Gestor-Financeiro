{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(npm run:*)",
      "Bash(npm --prefix frontend run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(scripts/verificar.sh:*)",
      "Bash(scripts/guardas/verificar-repositorio.sh:*)",
      "Bash(scripts/guardas/testes.sh:*)",
      "mcp__playwright__browser_console_messages"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./infra/secrets/**)",
      "Read(./backups/**)",
      "Read(./infra/data/**)",
      "Read(//opt/**)",
      "Edit(//opt/**)",
      "Edit(./infra/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(psql:*)",
      "Bash(docker compose down -v:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-delete-fisico.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verificar.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  }
}
