# Copie para infra/.env (fica fora do git) e ajuste.
# Subdomínio criado em duckdns.org (só o nome, sem .duckdns.org)
DUCKDNS_SUBDOMINIO=seu-nome
# Domínio completo servido pelo Caddy
DOMINIO=seu-nome.duckdns.org
# Token da conta DuckDNS (atualiza o IP e emite o certificado). Trate como senha.
DUCKDNS_TOKEN=troque-pelo-token
