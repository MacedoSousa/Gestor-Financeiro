# Copie para infra/.env (fica fora do git) e ajuste.
# Subdomínio criado em duckdns.org (só o nome, sem .duckdns.org)
DUCKDNS_SUBDOMINIO=seu-nome
# Domínio completo servido pelo Caddy
DOMINIO=seu-nome.duckdns.org
# Token da conta DuckDNS (atualiza o IP e emite o certificado). Trate como senha.
DUCKDNS_TOKEN=troque-pelo-token

# Backup (README, seção Backup)
GF_BACKUP_DIR=/var/backups/gestor
GF_BACKUP_DESTINATARIOS=/etc/gestor-backup/destinatarios.txt
# Obrigatório: remote do rclone para a cópia diária na nuvem, ex. nuvem:gestor-backup
GF_BACKUP_RCLONE_REMOTO=
# Opcionais: pendrive. Sem montagem, o backup só registra um aviso.
GF_BACKUP_PENDRIVE_MONTAGEM=
GF_BACKUP_PENDRIVE_PASTA=
