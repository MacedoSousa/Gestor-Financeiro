{
	# Sem painel admin; certificado Let's Encrypt via desafio DNS no DuckDNS (não precisa abrir a porta 80).
	admin off
	servers {
		trusted_proxies static private_ranges
	}
	order rate_limit before basic_auth
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

{$DOMINIO} {
	import seguranca
	encode zstd gzip

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}

	# Login e cadastro de passkey: no máximo 10 tentativas por minuto por IP.
	# A consulta do estado do pedido de celular novo (GET) fica de fora: tem zona própria.
	# O resgate do pedido (POST .../pedido/resgate) continua aqui.
	@autenticacao {
		path /api/v1/auth/*
		not {
			method GET
			path /api/v1/auth/dispositivo/pedido
		}
	}
	rate_limit @autenticacao {
		zone autenticacao {
			key {remote_host}
			events 10
			window 1m
		}
	}

	# Consulta do estado do pedido de celular novo: o celular pergunta de tempos em tempos; 60 por minuto por IP.
	@pedido {
		method GET
		path /api/v1/auth/dispositivo/pedido
	}
	rate_limit @pedido {
		zone pedido {
			key {remote_host}
			events 60
			window 1m
		}
	}

	# Cadastro do casal (sem sessão): no máximo 5 tentativas a cada 10 minutos por IP.
	@cadastro {
		method POST
		path /api/v1/casal /api/v1/casal/
	}
	rate_limit @cadastro {
		zone cadastro {
			key {remote_host}
			events 5
			window 10m
		}
	}

	# Resto da API: limite largo, só para conter abuso.
	rate_limit /api/* {
		zone api {
			key {remote_host}
			events 300
			window 1m
		}
	}

	# Webhook da Pluggy: só POST, corpo pequeno.
	@pluggy {
		method POST
		path /webhooks/pluggy
	}
	handle @pluggy {
		request_body {
			max_size 64KB
		}
		rewrite * /api/v1/integracoes/pluggy/webhook
		reverse_proxy 172.30.0.10:8080
	}

	handle /webhooks/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy 172.30.0.10:8080
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/logs/acesso.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
